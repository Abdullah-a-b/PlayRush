# ==========================================
# Systemd Timer للـ backups (بديل cron — أكثر قوة وresilience)
# ==========================================
# الإعداد:
#
# 1. انسخ هذين الملفين:
#    sudo cp playrush-backup-hourly.service /etc/systemd/system/
#    sudo cp playrush-backup-hourly.timer /etc/systemd/system/
#    sudo cp playrush-backup-daily.service /etc/systemd/system/
#    sudo cp playrush-backup-daily.timer /etc/systemd/system/
#
# 2. عدّل WorkingDirectory و ExecStart بالمسار الصحيح
#
# 3. فعّل الـ timers:
#    sudo systemctl daemon-reload
#    sudo systemctl enable --now playrush-backup-hourly.timer
#    sudo systemctl enable --now playrush-backup-daily.timer
#
# 4. تحقق:
#    sudo systemctl list-timers playrush-backup-*

# =====================================
# /etc/systemd/system/playrush-backup-hourly.service
# =====================================
[Unit]
Description=PlayRush Hourly DB Backup
After=postgresql.service network.target
Requires=postgresql.service

[Service]
Type=oneshot
User=playrush
Group=playrush
WorkingDirectory=/home/playrush/PlayRush/Backend
Environment=PATH=/home/playrush/PlayRush/Backend/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/home/playrush/PlayRush/Backend/venv/bin/python -m scripts.backup_db --tag hourly

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/home/playrush/PlayRush/Backend/backups
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
