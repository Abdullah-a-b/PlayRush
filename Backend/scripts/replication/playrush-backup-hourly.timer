# =====================================
# /etc/systemd/system/playrush-backup-hourly.timer
# =====================================
[Unit]
Description=Run PlayRush DB backup every hour
Requires=playrush-backup-hourly.service

[Timer]
OnCalendar=hourly
Persistent=true        # يلحق الـ run المفقودة لو السيرفر كان نائم
RandomizedDelaySec=5min  # تأخير عشوائي 0-5 دقائق (يوزع الحمل)

[Install]
WantedBy=timers.target
