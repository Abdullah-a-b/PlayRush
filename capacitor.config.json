{
  "appId": "app.playrush.game",
  "appName": "PlayRush",
  "webDir": "FrontEnd",
  "android": {
    "allowMixedContent": false,
    "webContentsDebuggingEnabled": true
  },
  "server": {
    "androidScheme": "https",
    "cleartext": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 400,
      "launchAutoHide": true,
      "backgroundColor": "#0f172a",
      "showSpinner": false
    },

    "Keyboard": {
      "resize": "native",
      "resizeOnFullScreen": true
    }
  }
}